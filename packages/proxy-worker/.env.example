# Copy to `.env` in this directory and fill in. Never commit the copy —
# `.env` and `.dev.vars` are both git-ignored; only this example is tracked.
#
# Then deploy everything with:
#   pnpm --filter @gitalk/proxy-worker deploy

# ---- Cloudflare ----------------------------------------------------------
# Create at https://dash.cloudflare.com/profile/api-tokens using the
# "Edit Cloudflare Workers" template. This is what the deploy script
# authenticates with, so no `wrangler login` is needed.
CLOUDFLARE_API_TOKEN=

# Optional. Only needed when the token can see more than one account; the
# deploy script will tell you the candidates if you leave it blank.
# CLOUDFLARE_ACCOUNT_ID=

# ---- GitHub App ----------------------------------------------------------
# All of these come from the App's settings page.
GITHUB_APP_ID=

# Client ID, looks like Iv1.… or Iv23li…
GITHUB_CLIENT_ID=

# "Client secrets" -> Generate a new client secret. Shown only once.
GITHUB_CLIENT_SECRET=

# Easiest: leave this blank and drop the downloaded .pem into this directory.
# The deploy script finds it, reads it, and checks it is git-ignored. Only one
# .pem may be present.
#
# Otherwise flatten it onto one line (which is fiddly but equivalent). It must
# be the KEY, not the `SHA256:…` fingerprint shown next to it in App settings:
#
#   awk 'NF {printf "%s\\n", $0}' ~/Downloads/<app>.private-key.pem
#
# Keep the BEGIN/END lines and use double quotes. PKCS#1 and PKCS#8 both work.
GITHUB_APP_PRIVATE_KEY=

# ---- Proxy behaviour -----------------------------------------------------
# 32 random bytes, hex encoded:  openssl rand -hex 32
SESSION_ENCRYPTION_KEY=

# Comma-separated origin allowlist. Must include the site that embeds the
# widget, or the browser will be blocked by CORS.
GITALK_ALLOWED_ORIGINS=https://gitalk.github.io,http://127.0.0.1:4181
