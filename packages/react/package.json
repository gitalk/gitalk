{
  "name": "@aifire/gitalk-react",
  "version": "2.1.0",
  "description": "React wrapper for Gitalk 2.0 comment widget.",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.types.json",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run typecheck && pnpm run build"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "dependencies": {
    "@aifire/gitalk": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "react": "19.3.1",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gitalk/gitalk.git",
    "directory": "packages/react"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
