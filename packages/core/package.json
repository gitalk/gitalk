{
  "name": "@aifire/gitalk",
  "version": "2.0.0-beta.0",
  "description": "Gitalk 2.0 core: framework-agnostic comment widget backed by GitHub Discussions (default) or Issues.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gitalk/gitalk.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./style.css": "./dist/gitalk.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build && vite build --config vite.iife.config.ts && tsc -p tsconfig.types.json",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run typecheck && pnpm run build"
  },
  "dependencies": {
    "preact": "11.0.1"
  },
  "devDependencies": {
    "@preact/preset-vite": "2.10.6",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vite-plugin-dts": "5.1.2"
  }
}
