{
  "name": "gitalk",
  "version": "1.8.0",
  "description": "A comment plugin based on GitHub issues",
  "keywords": [
    "comment",
    "plugin",
    "lib",
    "GitHub"
  ],
  "main": "./dist/gitalk.js",
  "module": "./dist/gitalk.mjs",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/gitalk.min.js",
  "jsdelivr": "./dist/gitalk.min.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/gitalk.mjs",
      "require": "./dist/gitalk.js",
      "default": "./dist/gitalk.mjs"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.mjs",
      "require": "./dist/react/index.cjs"
    },
    "./dist/gitalk.css": "./dist/gitalk.css",
    "./gitalk.css": "./dist/gitalk.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "prepublishOnly": "npm run build",
    "dev": "vite dev",
    "build": "npm run build:esm && npm run build:umd && npm run build:min && npm run build:react",
    "build:esm": "vite build",
    "build:umd": "vite build --mode umd",
    "build:min": "vite build --mode min",
    "build:react": "vite build --mode react",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "bump": "standard-version -a"
  },
  "author": "Liucw",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gitalk/gitalk.git"
  },
  "dependencies": {
    "preact": "^10.29.4"
  },
  "standard-version": {
    "releaseCommitMessageFormat": "chore(release): v{{currentTag}} :rocket:",
    "scripts": {
      "prerelease": "npm test"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@microsoft/api-extractor": "^7.58.9",
    "@testing-library/preact": "^3.2.4",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "github-markdown-css": "^5.9.0",
    "happy-dom": "^20.10.6",
    "prettier": "^3.9.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "standard-version": "^9.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1",
    "vite": "^8.1.3",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.9"
  }
}
