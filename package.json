{
  "name": "gitalk-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" run build",
    "build:landing": "pnpm --filter @gitalk/landing run build",
    "dev": "pnpm --filter @aifire/gitalk run dev",
    "dev:landing": "pnpm --filter @gitalk/landing run dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:docs": "node scripts/check-docs.mjs",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "@preact/preset-vite": "2.10.6",
    "@vitejs/plugin-react": "6.1.2",
    "@vitejs/plugin-vue": "6.0.10",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "@types/node": "24.10.1"
  }
}
